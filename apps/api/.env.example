# Copie este arquivo para ".env" (que é ignorado pelo Git) e preencha os valores reais.
# NUNCA faça commit do .env.

NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# MongoDB Atlas -> Connect -> Drivers. Inclua o nome do banco na URI (ex.: .../veritas-libris?...).
# No Atlas, libere seu IP em Network Access.
MONGODB_URI=mongodb://localhost:27017/veritas-libris-dev

# Firebase Console -> Configurações do projeto -> Contas de serviço -> Gerar nova chave privada.
# Copie os 3 campos abaixo do JSON baixado. A private_key pode ficar entre aspas com "\n" literal.
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Books. Sem chave a cota é compartilhada e pode esgotar (erro 429 -> a API responde 502).
# Google Cloud Console -> ativar "Books API" -> Credenciais -> Criar chave de API
# (restrinja a chave à Books API). Deixar vazio é permitido.
GOOGLE_BOOKS_API_KEY=

# Padrão: true (POST /api/v1/books/import exige login Firebase).
# Use false SÓ no .env local para testar sem frontend. Em produção a API recusa iniciar com false.
IMPORT_REQUIRES_AUTH=false

# Padrão: true (avaliações e voto útil exigem login Firebase).
# Em produção a API recusa iniciar com false.
REVIEW_REQUIRES_AUTH=false

# Origens permitidas no CORS separadas por vírgula (opcional; vazio libera qualquer origem em dev).
CORS_ORIGIN=

# E-mails de administradores iniciais separados por vírgula (recebem papel ADMIN automaticamente).
ADMIN_EMAILS=


