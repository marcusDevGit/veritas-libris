# URL base da API em produção (ex.: https://veritas-libris-api.up.railway.app).
# Em desenvolvimento local, deixe vazio para usar o proxy do Vite (/api -> localhost:3333).
VITE_API_URL=

# Chaves públicas do Web App Firebase (Configurações do Projeto -> App da Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
